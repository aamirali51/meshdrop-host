{
  "name": "@meshdrop-go/host",
  "version": "0.1.4",
  "description": "Headless MeshDrop node: boots MeshEngine (@meshdrop-go/core) without Electron and exposes the exact app protocol contract over a token-authed localhost HTTP + WebSocket API.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "mesh": "cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "api.js",
    "bridge.js",
    "excluded.js",
    "deps.js",
    "cli/",
    "vendor/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "mesh": "node cli/index.js",
    "vendor": "node scripts/sync-vendor.js",
    "test": "node test-conformance.js",
    "test:cli": "node cli/test-cli.js"
  },
  "dependencies": {
    "@meshdrop-go/core": "file:../meshdrop-core",
    "ws": "^8.18.0"
  }
}
